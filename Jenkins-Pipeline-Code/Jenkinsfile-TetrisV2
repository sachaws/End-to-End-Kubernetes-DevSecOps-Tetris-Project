```groovy
pipeline {

    agent any

    tools {
        nodejs 'nodejs'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/sachaws/End-to-End-Kubernetes-DevSecOps-Tetris-Project.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Tetris-V2') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=Tetris-V2 \
                            -Dsonar.projectKey=Tetris-V2
                        '''
                    }
                }
            }
        }

        stage('Quality Check') {
            steps {
                script {
                    waitForQualityGate(
                        abortPipeline: false,
                        credentialsId: 'sonar-token'
                    )
                }
            }
        }

        stage('Installing Dependencies') {
            steps {
                dir('Tetris-V2') {
                    sh 'npm install'
                }
            }
        }

        stage('OWASP Dependency-Check Scan') {
            steps {
                dir('Tetris-V2') {
                    dependencyCheck(
                        additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                        odcInstallation: 'DP-Check'
                    )

                    dependencyCheckPublisher(
                        pattern: '**/dependency-check-report.xml'
                    )
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('Tetris-V2') {
                    sh 'trivy fs . > trivyfs.txt'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                script {
                    dir('Tetris-V2') {
                        withDockerRegistry(
                            credentialsId: 'docker',
                            toolName: 'docker'
                        ) {
                            sh 'docker system prune -f'
                            sh 'docker build -t tetris-v2 .'
                        }
                    }
                }
            }
        }

        stage('Docker Image Pushing') {
            steps {
                script {
                    withDockerRegistry(
                        credentialsId: 'docker',
                        toolName: 'docker'
                    ) {
                        sh '''
                            docker tag tetris-v2 cloudops2026/tetris-v2:${BUILD_NUMBER}
                            docker push cloudops2026/tetris-v2:${BUILD_NUMBER}
                        '''
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    trivy image cloudops2026/tetris-v2:${BUILD_NUMBER} > trivyimage.txt
                '''
            }
        }

        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = 'End-to-End-Kubernetes-DevSecOps-Tetris-Project'
                GIT_USER_NAME = 'sachaws'
            }

            steps {
                dir('Manifest-file') {
                    withCredentials([
                        string(
                            credentialsId: 'github',
                            variable: 'GITHUB_TOKEN'
                        )
                    ]) {
                        sh '''
                            git config user.email "sachaws@users.noreply.github.com"
                            git config user.name "sachaws"

                            echo "Updating image to:"
                            echo "cloudops2026/tetris-v2:${BUILD_NUMBER}"

                            sed -i "s|image:.*|image: cloudops2026/tetris-v2:${BUILD_NUMBER}|" deployment-service.yml

                            git add deployment-service.yml

                            git commit -m "Update Tetris-V2 image to ${BUILD_NUMBER}" || echo "No changes to commit"

                            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:master
                        '''
                    }
                }
            }
        }
    }
}
